# Settings for deploy/server-setup.sh. Copy to deploy/server.env (git-ignored) and adjust.

# Root domain. The personal site lives on it, personal addresses use it (e.g. ilia@ershov.me).
DOMAIN=ershov.me
# Subdomain of the mail organizer: site https://veil.ershov.me, aliases x7k2m9q4ab@veil.ershov.me
SERVICE_SUBDOMAIN=veil
# Public IPv4 address of the server (A records and the PTR point to it)
SERVER_IP=203.0.113.10

# Personal addresses on the root domain and where they are forwarded.
# postmaster@ and abuse@ (required by the mail RFCs) are always forwarded there too.
PERSONAL_ADDRESSES="ilia"
FORWARD_TO=you@example.com

# Contact address for Let's Encrypt
ACME_EMAIL=ilia@ershov.me

# Docker subnet of the app. Only this subnet (and the server itself) may send mail through Postfix.
# Must not overlap with any other network on the server (e.g. a VPN).
APP_SUBNET=172.30.25.0/24

# Addresses fail2ban must never ban (your home IP, your VPN subnet), space separated
F2B_IGNORE="198.51.100.7 172.29.172.0/24"

# yes = SSH by key only. The script refuses if /root/.ssh/authorized_keys is empty.
SSH_KEY_ONLY=yes
