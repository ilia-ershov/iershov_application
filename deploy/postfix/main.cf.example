# Additions to /etc/postfix/main.cf for receiving mail for the alias domain and forwarding it.
# The MX record of w3r4kl.ru must point at this server.
virtual_alias_domains = w3r4kl.ru
virtual_alias_maps = pgsql:/etc/postfix/pgsql-aliases.cf

# Forwarded mail keeps the original sender, which breaks SPF at the destination.
# Rewrite the envelope sender with SRS (e.g. the postsrsd package) so forwarded mail is accepted.

# The service only receives: do not relay for anyone else.
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
