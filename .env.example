# Settings for docker compose. Copy to .env and fill in; never commit the real .env.

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=

MAIL_DOMAIN=w3r4kl.ru
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Reverse proxies in front of the API: 1 = only the bundled nginx,
# 2 = another TLS proxy (Caddy, nginx, Traefik...) in front of it. Needed for correct client IPs.
TRUST_PROXY=1

# console = codes are printed in `docker compose logs backend`; smtp = real delivery
MAIL_BACKEND=console
MAIL_FROM=no-reply@w3r4kl.ru
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
