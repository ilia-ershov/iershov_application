# Copy to project/.env and fill in. Never commit the real .env.

# Required: random string of 32+ characters
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Required: PostgreSQL connection string
DATABASE_URL=postgresql://mail_organizer:password@127.0.0.1:5432/mail_organizer

# Domain of the forwarding addresses
MAIL_DOMAIN=w3r4kl.ru

# Outgoing mail (verification codes and security notifications)
#   console = print messages to the server log (development only)
#   smtp    = deliver through the SMTP server below
MAIL_BACKEND=console
MAIL_FROM=no-reply@w3r4kl.ru
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false

# Only if the frontend is served from another origin (comma separated). Empty = CORS off.
CORS_ORIGINS=
# Number of reverse proxies in front of the app (1 behind nginx); needed for correct client IPs.
TRUST_PROXY=0
# Rate-limit storage; use redis://... when running several app processes.
RATELIMIT_STORAGE_URI=memory://

ACCESS_TOKEN_TTL_MINUTES=240
MAX_ALIASES_PER_USER=100
# Create/upgrade tables on start (disable when several workers start at once; run `flask --app app init-db` instead)
AUTO_INIT_DB=true
# Development server only
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
